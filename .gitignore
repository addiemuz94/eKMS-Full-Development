.gradle/
.gradle-home/
.idea/
local.properties
**/build/
*.iml
.DS_Store
.kotlin/

# Secrets — never commit real env files
backend/.env
backend/.env.production
**/.env
!**/.env.example
!**/.env.production.example

# React portal (also has web/.gitignore)
web/node_modules/
web/dist/

# Firebase app config (per-project API keys) — never commit
**/google-services.json

# Firebase Admin / FCM service-account JSON (host path used by docker-compose.prod.yml)
secrets/
**/fcm-service-account.json
**/*-firebase-adminsdk-*.json

# Local signing keystores/credentials — never commit (see terminalApp/mobileApp
# build.gradle.kts release signingConfig, loaded from keystore.properties)
*.jks
*.keystore
mobileApp/keystore/
terminalApp/keystore/
keystore.properties
